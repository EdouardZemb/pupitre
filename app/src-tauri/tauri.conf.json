{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pupitre",
  "version": "0.0.0",
  "identifier": "app.pupitre.etabli",
  "build": {
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../ui" },
    "beforeDevCommand": { "script": "trunk serve", "cwd": "../ui" },
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "pupitre", "width": 1440, "height": 900 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' http://captation.localhost; media-src 'self' http://captation.localhost; connect-src 'self' http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/icon.ico"]
  }
}
